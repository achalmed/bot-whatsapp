# Datos del despacho. Copia este archivo como `.env` y complétalo: `.env` no se sube a git.
# Las redes que se dejen vacías no aparecen en el menú.

DESPACHO_NOMBRE="Despacho del Diputado Nombre Apellido"
DESPACHO_MESA_PARTES_URL=
DESPACHO_DIRECCION=
# Opcional: si se deja vacío, se arma la búsqueda de Google Maps con la dirección.
DESPACHO_MAPA_URL=
DESPACHO_CORREO=
DESPACHO_TELEFONO=

DESPACHO_FACEBOOK_URL=
DESPACHO_X_URL=
DESPACHO_INSTAGRAM_URL=
DESPACHO_TIKTOK_URL=
DESPACHO_YOUTUBE_URL=

# Minutos que el bot se pausa cuando alguien pide hablar con el equipo (opción 5).
DESPACHO_PAUSA_MINUTOS=60

# Opcional: versión de WhatsApp Web si aparece ERRO AUTH (https://wppconnect.io/whatsapp-versions/)
# WA_VERSION=2.3000.1035824857
